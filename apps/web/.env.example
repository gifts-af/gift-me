# Copy of what `npx vercel env pull .env.development.local` gives you (see apps/web/README.md).
# Don't fill this file in. Pull the real values from Vercel instead, and never commit them.

# Supabase: dev project for Development and Preview, prod for Production (README > Environments).
# Both values are public and limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The Chrome extension's ID (ALL-22, apps/extension/README.md). The connect page messages it,
# and /api/captures allows only its origin. Public; the same in every environment.
NEXT_PUBLIC_EXTENSION_ID=nnakijeilmglcmjpdpagacbjannapafb

# Server-only service-role key; bypasses RLS, so never NEXT_PUBLIC and never in the browser.
SUPABASE_SECRET_KEY=

# AI Gateway (T39). Deployed on Vercel, the app signs in with this short-lived
# token automatically, so Preview and Production need no key.
VERCEL_OIDC_TOKEN=
# Development only: a dev gateway key, so local runs and the AI spike don't
# depend on the 12-hour token above. Shared through vercel env pull.
AI_GATEWAY_API_KEY=

# Authenticates the daily crons: the keep-alive (T22) and the round tick (T49). Vercel sets it on
# production; set any value locally or on a preview to call /api/rounds/tick by hand (Playwright sets its own).
# CRON_SECRET=

# Local and e2e only: EMAIL_OUTBOX=log logs emails instead of sending them (ignored in production, ALL-28).
# EMAIL_OUTBOX=

# Resend (email, T33). Dev key in Development and Preview, prod key (Sensitive) in Production.
# Full access: the app also reads received mail (design/spikes/email.md).
RESEND_API_KEY=

# Zinc app-owned account for product lookups (T17). Dev key in Development and Preview,
# prod key (Sensitive) in Production. Users' own Zinc keys live in Vault, not here (§6.5a).
ZINC_API_KEY=

# Connecting users' own Zinc accounts from Settings (ALL-32). ZINC_ENV is "test" (sandbox key, no Allow
# step) or "live"; anything else turns it off. ZINC_API_BASE is Zinc's API address, no fallback.
ZINC_ENV=
ZINC_API_BASE=
# Where a Zinc user adds funds, saves a card and turns on auto top-up (the Settings guide's "Open Zinc
# wallet" button). Checked by the owner with a real Zinc login on 2026-11-06: Settings > Payments has all three.
ZINC_WALLET_URL=https://app.zinc.com/settings/payments

# Cloudflare Turnstile, the bot check on public forms (ALL-68, T43). Development and Preview
# use Cloudflare's always-pass test keys (shown); Production uses the real GiftsAF widget
# (secret is Sensitive). Supabase checks the same token on sign-up, sign-in and password reset.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google Contacts import (ALL-24): the public OAuth client id Supabase's Google sign-in uses.
# The same in every environment; its JavaScript origins are set in Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=135297750935-8adn8jk7khtn57diko322jhbfcoo2bbp.apps.googleusercontent.com

# When the logo wears its Santa hat (ALL-48), as MM-DD..MM-DD in US Eastern time.
# Not secret; the same in every environment. Unset means the plain logo.
HOLIDAY_LOGO_DATES=11-01..12-26
