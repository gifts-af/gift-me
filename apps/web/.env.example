# Copy of what `npx vercel env pull .env.development.local` gives you (see apps/web/README.md).
# Don't fill this file in. Pull the real values from Vercel instead, and never commit them.

# Supabase: dev project for Development and Preview, prod for Production (README > Environments).
# Both values are public and limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Short-lived token Vercel issues for the AI Gateway. vercel env pull refreshes it.
VERCEL_OIDC_TOKEN=

# Production only: authenticates the daily keep-alive cron (T22).
# CRON_SECRET=
