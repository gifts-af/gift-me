{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs",
  "functions": {
    "app/api/rounds/job/route.ts": {
      "experimentalTriggers": [
        { "type": "queue/v2beta", "topic": "round-jobs", "maxDeliveries": 3, "maxConcurrency": 5 }
      ]
    }
  },
  "crons": [
    { "path": "/api/health", "schedule": "0 14 * * *" },
    { "path": "/api/rounds/tick", "schedule": "0 12 * * *" }
  ]
}
