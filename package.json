{
  "name": "gifts-af",
  "private": true,
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:check": "node scripts/dev-check.mjs",
    "dev": "pnpm --filter @gifts-af/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:changed": "pnpm -r test:changed",
    "db:clean": "node scripts/db-clean.mjs",
    "db:test": "node scripts/db-clean.mjs supabase test db",
    "db:start:tests": "supabase start -x studio,imgproxy,mailpit,edge-runtime,logflare,vector,supavisor,realtime,storage-api,postgres-meta",
    "test:db": "node scripts/db-clean.mjs pnpm --filter @gifts-af/web test:db",
    "check:bundle": "pnpm --filter @gifts-af/web check:bundle",
    "e2e": "node scripts/db-clean.mjs pnpm --filter @gifts-af/web e2e",
    "e2e:browsers": "pnpm --filter @gifts-af/web exec playwright install --with-deps chromium webkit",
    "e2e:browsers:deps": "pnpm --filter @gifts-af/web exec playwright install-deps chromium webkit",
    "db:push:dev": "node scripts/db-push.mjs bcemtqvdbrrgiipzggyw",
    "db:push:prod": "node scripts/db-push.mjs pegtrucfuaaufqvsavpb",
    "db:types": "supabase gen types typescript --local --schema public --schema concierge --schema lists > packages/core/src/database.types.ts && prettier --write --log-level warn packages/core/src/database.types.ts",
    "db:types:check": "node scripts/db-types-check.mjs",
    "db:map": "pnpm --filter @gifts-af/web db:map",
    "db:map:check": "pnpm --filter @gifts-af/web db:map:check",
    "ai:eval": "pnpm --filter @gifts-af/web ai:eval",
    "gallery": "node scripts/db-clean.mjs pnpm --filter @gifts-af/web gallery",
    "live-check": "pnpm --filter @gifts-af/web live-check",
    "extension:package": "pnpm --filter @gifts-af/extension package"
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0"
  }
}
