{
  "name": "gifts-af",
  "private": true,
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:check": "node scripts/dev-check.mjs",
    "dev": "pnpm --filter @gifts-af/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:test": "supabase test db",
    "test:db": "pnpm --filter @gifts-af/web test:db",
    "check:bundle": "pnpm --filter @gifts-af/web check:bundle",
    "db:push:dev": "supabase db push --project-ref bcemtqvdbrrgiipzggyw --yes",
    "db:push:prod": "supabase db push --project-ref pegtrucfuaaufqvsavpb --yes",
    "db:types": "supabase gen types typescript --local --schema public --schema concierge --schema lists > packages/core/src/database.types.ts && prettier --write --log-level warn packages/core/src/database.types.ts",
    "ai:eval": "pnpm --filter @gifts-af/web ai:eval",
    "gallery": "pnpm --filter @gifts-af/web gallery",
    "live-check": "pnpm --filter @gifts-af/web live-check"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supabase": "^2.122.0"
  }
}
